# Google Sheet that receives signups (one tab per state). The ID is the long string in the sheet URL.
GOOGLE_SPREADSHEET_ID=

# Auth to Google Sheets is keyless by default (Application Default Credentials; see README).
# Optional key-based fallback for hosts without ADC. Do not prefix these with NEXT_PUBLIC_.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Stripe donations. Checkout is disabled until both are set. Use a restricted key (rk_...), see README.
STRIPE_SECRET_KEY=
# Webhook signing secret: from the Dashboard endpoint, or printed by `stripe listen` locally.
STRIPE_WEBHOOK_SECRET=
# Optional, public: Stripe Customer portal login link (Settings > Billing > Customer portal). Shown as a fallback manage link.
# STRIPE_PORTAL_LOGIN_URL=https://billing.stripe.com/p/login/...

# Email (Resend). Sending is skipped until both are set.
RESEND_API_KEY=
# Any long random string; signs unsubscribe links. Changing it invalidates links already sent.
UNSUBSCRIBE_SECRET=
# Optional overrides
# EMAIL_FROM="Rank America <hello@rankamerica.org>"
# SITE_URL=https://rankamerica.org   (set to http://localhost:3000 locally so Checkout returns there)
