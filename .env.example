# Server-only Google Sheets credentials. Do not prefix these with NEXT_PUBLIC_.
# Give the service account Editor access to your existing Rank America Signups Sheet.
GOOGLE_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Provide the hosted PayPal donation URL after setting it up with PayPal.
NEXT_PUBLIC_PAYPAL_DONATION_URL=


# Address to receive unsubscribe/privacy requests. Required before taking real signups.
NEXT_PUBLIC_CONTACT_EMAIL=
